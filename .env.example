# ========================================================
# CS.RIN.RU Discord Auto-Poster Configuration
# ========================================================

# Option A: Discord Bot (Interactive Bot with commands)
# Create a bot at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Option B: Discord Webhook (Simpler setup - no bot token needed!)
# In Discord channel settings -> Integrations -> Create Webhook -> Copy Webhook URL
# If DISCORD_BOT_TOKEN is blank, the script automatically uses this Webhook!
DISCORD_WEBHOOK_URL=

# Optional: CS.RIN.RU Session Cookie (Unlocks hidden download links: [[Please login to see this link.]])
# Example: phpbb3_..._u=12345; phpbb3_..._k=abcdef; phpbb3_..._sid=...
CSRIN_COOKIE=

# Neon.tech Cloud Database (Serverless Postgres Persistence for Koyeb / Docker)
NEON_DATABASE_URL=postgresql://neondb_owner:npg_1oBy0JMPfzsd@ep-crimson-dream-b3cs1xnt-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional Fallback: Supabase Cloud Database
SUPABASE_URL=https://pbhojxubeuapmfvmuoig.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here


